# ==============================================
# RoadGuard Environment Configuration
# ==============================================

# Application Metadata
PROJECT_NAME=RoadGuard
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1

# Security & CORS (JSON array or comma-separated URLs)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:3000"]

# Database Configuration
# Local SQLite fallback for immediate out-of-the-box operation:
DATABASE_URL=sqlite:///./roadguard.db
# PostgreSQL configuration (Production / Docker):
# DATABASE_URL=postgresql://roadguard_user:roadguard_pass@localhost:5432/roadguard_db

# Deep Learning Model Configuration
MODEL_PATH=ml/models/best.pt
MODEL_DEVICE=cpu
MODEL_CONFIDENCE_THRESHOLD=0.25
MODEL_IOU_THRESHOLD=0.45

# Storage & Upload Limits
UPLOAD_DIR=backend/uploads
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=["jpg", "jpeg", "png"]

# Frontend API URL (for frontend .env)
VITE_API_BASE_URL=http://localhost:8000/api/v1

